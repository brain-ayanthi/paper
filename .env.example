APP_NAME="POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL is the only supported database. The installer fills these in at Step 4
# (Database). Leave them blank in the shipped template.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos
DB_USERNAME=root
DB_PASSWORD=

# File-based session + cache so the app needs NO database to boot — the
# installer runs (and renders its CSRF-protected forms) before any database
# exists. Shared-hosting friendly: no Redis, no extra DB round-trip per request.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

# Queue runs on the database driver, drained by cron (no daemons).
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail logs by default; the customer configures real SMTP in Settings.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# License — written by the installer at Step 3.
# Set POS_LICENSE_REQUIRED=false to skip license activation entirely (installer
# license step + background re-check). Leave it out (or true) to enforce.
# POS_LICENSE_REQUIRED=true
# Explicitly bypass validation on servers unable to reach the validator (including production).
POS_LICENSE_DEV_BYPASS=false
# Temporary pre-launch exception for the optional fresh SaaS installer only.
# It does not activate core licensing or bypass the separate SaaS purchase.
POS_FRESH_SAAS_CORE_PURCHASE_LAUNCH_BYPASS=false
# Optional pre-business SaaS loader. Keep disabled and empty until a host
# operator stages a production-signed delivery and approves the host bridge.
POS_FRESH_SAAS_INSTALLER=false
POS_FRESH_SAAS_SOURCE_DIRECTORY=
POS_FRESH_SAAS_TRUSTED_KEY_SHA256=
POS_LICENSE_CHECK_URL=https://validator-new.infinitietech.com/api/v1/validate
LICENSE_REGISTRATION_TOKEN=
LICENSE_KEY=
LICENSE_FINGERPRINT=

# Developer / maintenance web routes — /migrate, /seed, /clear-cache,
# /storage-link, /phpinfo, /debug-refund, /simulate-gateway-refund and the demo
# baseline routes. They exist for shared hosting with no SSH.
#
# LEAVE THESE OFF ON ANY INSTALL A CUSTOMER OR THE PUBLIC CAN REACH.
# With POS_DEV_ROUTES unset, routes/dev.php is never loaded and none of those
# URLs exist. With it on, /migrate?fresh=1 can drop the whole database.
#
# The destructive ones (/migrate?fresh=1, /seed, /demo-reset, /demo-snapshot)
# additionally need ?token=<POS_DEV_TOKEN>, or a signed-in super admin. Set the
# token to a long random string — an empty token never matches, it does not
# disable the check.
# POS_DEV_ROUTES=true
# POS_DEV_TOKEN=

# Demo mode — flip ON for the public demo install. When true, the login page
# shows a small notice with a link to POS_DEMO_WEBSITE_URL so visitors who land
# on the demo can find their way back to the product website. Leave OFF for
# real customer installs.
# POS_DEMO_MODE=true
# POS_DEMO_WEBSITE_URL=https://infinitietech.com
# Pre-fillable demo credentials shown on the login page. Each pair adds a
# "Copy & Fill" card. Leave a pair blank to hide that role's card.
# POS_DEMO_ADMIN_EMAIL=admin@demo.test
# POS_DEMO_ADMIN_PASSWORD=12345678
# POS_DEMO_CASHIER_EMAIL=cashier@demo.test
# POS_DEMO_CASHIER_PASSWORD=12345678
# Landing-page ebook lead capture. Upload the PDF at the default private path,
# or set absolute custom paths for the PDF and private lead CSV.
# POS_DEMO_EBOOK_PDF_PATH=
# POS_DEMO_EBOOK_DOWNLOAD_NAME=Hyper-POS-eBook.pdf
# POS_DEMO_EBOOK_LEADS_PATH=
# SHA-256 hash of the long token used in the public marketing-team CSV URL.
# POS_DEMO_EBOOK_LEADS_DOWNLOAD_TOKEN_HASH=

# Auto-updater. Both have working defaults in config/pos.php — including the
# release signing public key, which is deliberately baked in there rather than
# here, because config/pos.php is replaced by every update while a customer's
# .env is not. Override only for a fork or a staging feed.
# POS_UPDATE_FEED_URL=https://updates.infinitietech.com/pos.json
# POS_UPDATE_PUBLIC_KEY=
#
# Disables signature verification on feed updates. For developing the update
# flow without a signing key ONLY — never set this on an install anyone else
# can reach.
# POS_UPDATE_ALLOW_UNSIGNED=false

VITE_APP_NAME="${APP_NAME}"
